<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh substitutes @VERSION@
     and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <!-- rDNS no AppStream (exigência do appstreamcli); a identidade do app — WM class, .desktop,
       ícone, nomes de asset do updater — continua flat "local-utils" (launchable abaixo). -->
  <id>com.local.localutils</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Local Utils</name>
  <summary>Clipboard manager and everyday tools, fully offline</summary>
  <developer id="com.local.localutils">
    <name>Local Utils contributors</name>
  </developer>
  <description>
    <p>
      Local Utils is an open-source collection of everyday tools written in pure Rust, anchored
      by a clipboard manager that lives in the tray. Clipboard history with search and pins,
      screenshot with annotation, clock, calculator, converter, developer tools, scratchpad,
      system monitor and colour picker. No account, no telemetry, no third-party servers.
      100% local and offline.
    </p>
  </description>
  <launchable type="desktop-id">local-utils.desktop</launchable>
  <icon type="stock">local-utils</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/Anon5T4R/Local-Utils</url>
  <url type="bugtracker">https://github.com/Anon5T4R/Local-Utils/issues</url>
  <url type="help">https://github.com/Anon5T4R/Local-Utils</url>
  <url type="contact">https://github.com/Anon5T4R/Local-Utils/issues</url>
  <categories>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>utils</keyword>
    <keyword>utilities</keyword>
    <keyword>clipboard</keyword>
    <keyword>calculator</keyword>
    <keyword>tools</keyword>
  </keywords>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <!-- The .lutils export is a private format, so no file mediatype is claimed: only the binary. -->
  <provides>
    <binary>local-utils</binary>
  </provides>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
