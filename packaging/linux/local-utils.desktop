[Desktop Entry]
Type=Application
Name=Local Utils
GenericName=Utilities
Keywords=utils;utilities;tools;clipboard;calculator;screenshot;local;
Exec=local-utils
Icon=local-utils
Categories=Utility;
Comment=Utilitários do cotidiano 100% locais e offline — clipboard na bandeja
Terminal=false
# O runner nativo não completa o handshake de startup-notification (igual ao local-image).
StartupNotify=false
StartupWMClass=local-utils
