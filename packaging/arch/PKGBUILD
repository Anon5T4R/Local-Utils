# PKGBUILD do Local Utils para Arch (uso pessoal do João; não publicado no AUR).
# Instala a árvore FHS (bin/ + share/) do tarball da release — o mesmo artefato
# que o package.sh gera —, então pacman -Ql lista os arquivos e pacman -R remove
# tudo. O sha256 fica SKIP porque o hash só existe após a release existir; confie
# no transport (HTTPS) ou preencha manualmente com `updpkgsums`.
#
#   makepkg -si

pkgname=local-utils
pkgver=0.6.1
pkgrel=1
pkgdesc='Utilitários do cotidiano 100% locais e offline — clipboard na bandeja'
arch=(x86_64)
url='https://github.com/Anon5T4R/Local-Utils'
license=('GPL-3.0-or-later')
depends=(glibc gcc-libs libxcb libxrandr libxi libxcursor libxkbcommon)
source=("local-utils-$pkgver-linux-x86_64.tar.gz::https://github.com/Anon5T4R/Local-Utils/releases/download/v$pkgver/local-utils-$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir"
  install -dm755 "$pkgdir/usr"
  cp -a "local-utils-$pkgver-linux-x86_64/bin" "$pkgdir/usr/"
  cp -a "local-utils-$pkgver-linux-x86_64/share" "$pkgdir/usr/"
}
